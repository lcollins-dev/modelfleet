{
  "name": "@apps/agent",
  "private": true,
  "scripts": {
    "build": "rm -rf dist && nest build",
    "start": "npm run start:dev",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "code:lint": "eslint .",
    "code:lint:fix": "eslint . --fix",
    "code:format": "prettier --write .",
    "code:format:check": "prettier --check .",
    "code:typecheck": "tsc --noEmit -p tsconfig.json",
    "npm:clean": "rm -rf node_modules"
  },
  "dependencies": {
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/microservices": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "dockerode": "5.0.1",
    "ms": "2.1.3",
    "nestjs-pino": "4.5.0",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.6",
    "@swc/core": "1.15.33",
    "@types/dockerode": "4.0.1",
    "@types/ms": "2.1.0",
    "@types/node": "22.17.2",
    "@types/ws": "8.18.1",
    "unplugin-swc": "1.5.9"
  }
}
