{
  "name": "modelfleet",
  "version": "0.0.0",
  "author": "Louis Collins",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "build": "npm run build:libs && npm run build:server && npm run build:agent && npm run build:web",
    "build:libs": "tsc --build --clean && tsc --build",
    "build:server": "npm run build -w apps/server",
    "build:agent": "npm run build -w apps/agent",
    "build:web": "npm run build -w apps/web",
    "start:web": "npm start -w apps/web",
    "start:server": "npm start -w apps/server",
    "start:agent": "npm start -w apps/agent",
    "db:clean": "npm run db:clean -w apps/server",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration -w apps/server",
    "test:e2e": "npm run e2e -w e2e",
    "code:format": "npm run code:format --workspaces --if-present",
    "code:format:check": "npm run code:format:check --workspaces --if-present",
    "code:lint": "npm run code:lint --workspaces --if-present",
    "code:lint:fix": "npm run code:lint:fix --workspaces --if-present",
    "code:typecheck": "tsc --build --force && npm run code:typecheck --workspaces --if-present",
    "code:check": "npm run code:format:check && npm run code:lint && npm run code:typecheck && npm test",
    "docker:build:server": "docker build --build-arg='APP_VERSION=0.0.0' -t ghcr.io/lcollins-dev/modelfleet-server:dev -f build/Dockerfile-server .",
    "docker:build:agent": "docker build --build-arg='APP_VERSION=0.0.0' -t ghcr.io/lcollins-dev/modelfleet-agent:dev -f build/Dockerfile-agent .",
    "compose:up": "cd resources/compose && docker compose up -d",
    "compose:logs": "cd resources/compose && docker compose logs -f",
    "compose:ps": "cd resources/compose && docker compose ps",
    "compose:down": "cd resources/compose && docker compose down -v",
    "instance:start": "bash resources/instanced/start-all.sh",
    "instance:stop": "bash resources/instanced/stop.sh",
    "instance:db:clean": "bash resources/instanced/clean.sh",
    "instance:db:sql": "bash resources/instanced/db-sql.sh",
    "npm:clean": "rm -rf node_modules && npm run npm:clean --workspaces"
  },
  "workspaces": [
    "apps/server",
    "apps/agent",
    "apps/web",
    "libs/dto",
    "libs/agent-protocol",
    "libs/backends",
    "libs/runtime",
    "e2e"
  ],
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@trivago/prettier-plugin-sort-imports": "6.0.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.0",
    "vitest": "4.1.11"
  }
}
