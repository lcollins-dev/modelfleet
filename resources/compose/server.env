WEB_APP_BASE_URL=http://localhost:8080

BLOCKED_AT_ENABLED=false

# Leave false unless a proxy fronts the server, then name it, or `loopback, linklocal, uniquelocal` for a local one.
TRUST_PROXY=false

LOG_STDOUT_PRETTY=true
LOG_FILE_PATH=

TYPEORM_HOST=db
TYPEORM_LOGGING=false
TYPEORM_MIGRATIONS_RUN=true

EMAIL_FROM_ADDRESS=local-dev@modelfleet.test
